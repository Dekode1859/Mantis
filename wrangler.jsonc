{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mantis-preview",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "services": [
    {
      "binding": "SCRAPER",
      "service": "mantis-scraper-preview"
    }
  ],
  "observability": {
    "enabled": true
  }
}
